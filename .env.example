# ===== 张真源抖音监测站 · 环境变量配置（部署到云端时通过平台控制台注入，勿提交真实值）=====
# 复制本文件为 .env 用于本地运行；云端部署请在平台的环境变量面板填写。

# --- 数据源（唯一权威开关）---
# douyin_web = 免费抖音 web 端 Cookie 模式（零积分）；maxhub = 付费 API（需 MAXHUB_API_KEY）
DATA_SOURCE=douyin_web

# --- 抖音登录 Cookie（等同账号凭据，建议用小号；用于免费真实拉取主页/作品数据）---
# 从浏览器登录抖音后，F12 → Network → 任意 douyin.com 请求 → 复制 Cookie 请求头完整内容
DOUYIN_COOKIE=

# --- 目标账号（已预填张真源，一般无需改）---
DOUYIN_SEC_UID=MS4wLjABAAAAOpX2NjhZ8eTZFkP6BeKiWOxQXo264vHMFU8Zngk6Nrh61qKZjDjJO5ZvnyoZKN_E
DOUYIN_SHARE_URL=https://v.douyin.com/RQ20zd4XbUo/
DOUYIN_SHORT_ID=29832527783
TARGET_NAME=张真源

# --- 后台管理登录（务必改成你自己的强密码！）---
ADMIN_USER=kylinwu
ADMIN_PASS=请改成强密码
# 可选：自定义会话密钥（不填则每次重启随机，登录会失效）
ADMIN_SESSION_SECRET=

# --- 端口（云平台通过环境变量 PORT 注入；本地默认 8765）---
# PORT=8765
SERVER_PORT=8765

# --- 内嵌定时采集（部署到云端默认开启；设为 1 可关闭，改由外部调度）---
# DISABLE_SCHEDULER=0

# --- 可选：付费兜底（仅当 DATA_SOURCE=maxhub 时才需要）---
# MAXHUB_API_KEY=

# --- 可选：QQ 邮箱推送（免费 SMTP）---
# QQ_SMTP_ENABLED=false
# QQ_EMAIL=
# QQ_SMTP_PASS=
# PUSH_TO_QQ=

# --- 可选：去水印下载 token（nologo-open-api；仅下载器需要）---
# NOLOGO_TOKEN=
